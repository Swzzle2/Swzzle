# Copy to .env.local and fill in. Never commit .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only used by `npm run admin:promote`. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Connect > Session pooler URI (with your DB password). Only used by `npm run db:push`.
SUPABASE_DB_URL=

# Base URL encoded into Snap QR codes. Defaults to https://swzzle.com so labels printed
# from a local admin still point at production.
NEXT_PUBLIC_SITE_URL=https://swzzle.com
