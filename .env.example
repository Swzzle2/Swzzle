# Copy to .env.local and fill in. Never commit real values.
# On Vercel, set the same names under Project Settings > Environment Variables.

# Supabase project URL. Inlined into the browser bundle at BUILD time; the build fails without it.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key. Inlined into the browser bundle at BUILD time; the build fails without it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe secret key (sk_...), used server-side for checkout and order session lookups.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...), verifies /api/webhooks/stripe events.
STRIPE_WEBHOOK_SECRET=

# Resend API key for transactional email. If unset, emails are skipped.
RESEND_API_KEY=
# Sender address for outgoing email. Optional; defaults to "Swzzle <noreply@swzzle.com>".
EMAIL_FROM=

# Password for the /hq admin login.
ADMIN_PASSWORD=

# Vercel Blob read/write token for product data and uploads. If unset, falls back to local /data files.
BLOB_READ_WRITE_TOKEN=

# xAI API key for the HQ Grok writing assistant. XAI_API_KEY is accepted as a fallback name.
GROK_API_KEY=
